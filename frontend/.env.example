# API Configuration
VITE_API_URL=/api

# Cloudflare Turnstile Site Key
# Get your keys at: https://dash.cloudflare.com/
# Add domains: hnglinh.io.vn, www.hnglinh.io.vn, localhost
VITE_TURNSTILE_SITE_KEY=your_site_key_here

# Domain dùng cho prefix hiển thị trong URL Shortener (phải trùng với SHORT_URL_BASE ở backend)
VITE_SHORT_URL_BASE=https://hnglinh.io.vn
