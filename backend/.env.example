# Backend Environment Variables
# Copy this file to .env and fill in your values

# Cloudflare Turnstile Secret Key
# Get from: https://dash.cloudflare.com/
TURNSTILE_SECRET_KEY=your_secret_key_here

# Database (if using production database)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=https://hnglinh.io.vn,https://www.hnglinh.io.vn,http://localhost:5173

# Domain Configuration
# BASE_DOMAIN: domain mặc định cho tất cả các link (short URL, paste share)
BASE_DOMAIN=https://hnglinh.io.vn

# SHORT_URL_BASE: domain dùng cho URL rút gọn (mặc định = BASE_DOMAIN nếu không set)
# SHORT_URL_BASE=https://hnglinh.io.vn

# PASTE_URL_BASE: domain dùng cho link chia sẻ paste (mặc định = BASE_DOMAIN nếu không set)
# PASTE_URL_BASE=https://hnglinh.io.vn
